<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 1. CONSOLE APPENDER: Isme saare frameworks aur app ke logs dikhenge -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2. FILE APPENDER: Isme log file ka setup hai -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/application.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 3. SPECIFIC LOGGER FOR YOUR APP (Only com.backend goes to FILE) -->
    <!-- additivity="true" ka matlab hai ki yeh console par bhi print hoga -->
    <logger name="com.backend" level="INFO" additivity="true">
        <appender-ref ref="FILE" />
    </logger>

    <!-- 4. ROOT LOGGER: Baaki saare Frameworks (Spring, Hibernate, etc.) sirf CONSOLE par jayenge -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>